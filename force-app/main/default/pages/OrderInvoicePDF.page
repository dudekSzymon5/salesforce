<apex:page standardController="Invoice__c" 
           extensions="InvoicePDFController" 
           renderAs="pdf" 
           applyBodyTag="false"
           applyHtmlTag="false"
           showHeader="false" 
           sidebar="false">
<html>
<head>
<style type="text/css">
    body, table, td, th, p, div, span, h1, h2, h3 {
    font-family: Arial, Helvetica, sans-serif;
    }
    body {
        font-size: 11px;
        color: #222;
        margin: 40px;
    }
    table {
        border-collapse: collapse;
    }
</style>
</head>
<body>

<table width="100%" cellpadding="0" cellspacing="0">
    <tr>
        <td width="50%" valign="middle">
            <apex:image url="{!$Resource.ApexSync}" height="55px"/>
        </td>
        <td width="50%" valign="top" align="right">
            <div style="font-size:28px; font-weight:bold; color:#2C3E50;">INVOICE</div>
            <table cellpadding="2" cellspacing="0" align="right" style="margin-top:6px;">
                <tr>
                    <td style="font-size:11px; color:#444;"><b>Invoice No:</b></td>
                    <td style="font-size:11px; color:#444;"><apex:outputText value="{!invoice.Name}"/></td>
                </tr>
                <tr>
                    <td style="font-size:11px; color:#444;"><b>Issue Date:</b></td>
                    <td style="font-size:11px; color:#444;">
                        <apex:outputText value="{0,date,dd/MM/yyyy}">
                            <apex:param value="{!TODAY()}"/>
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td style="font-size:11px; color:#444;"><b>Order No:</b></td>
                    <td style="font-size:11px; color:#444;"><apex:outputText value="{!invoice.Order__r.OrderNumber}"/></td>
                </tr>
                <tr>
                    <td colspan="2" align="right" style="padding-top:4px; font-size:11px; color:#444;">
                        <b>Status:</b>
                        <apex:outputPanel rendered="{!invoice.Status__c == 'Draft'}">
                            <span style="color:#cc0000; font-weight:bold;">Unsigned</span>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!invoice.Status__c == 'Signed'}">
                            <span style="color:#28a745; font-weight:bold;">Signed</span>
                        </apex:outputPanel>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;">
    <tr>
        <td style="border-top:3px solid #2C3E50; font-size:0;">&nbsp;</td>
    </tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:14px;">
    <tr>
        <td width="48%" valign="top" style="border:1px solid #ddd; background-color:#fafafa;">
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="background-color:#e2e8f0; color:#111; font-weight:bold; font-size:10px; padding:6px 8px; text-transform:uppercase; border-bottom:1px solid #ddd;">
                        Seller
                    </td>
                </tr>
                <tr>
                    <td style="font-size:13px; font-weight:bold; padding:8px 8px 2px 8px;">
                        ApexSync
                    </td>
                </tr>
                <tr>
                    <td style="font-size:11px; color:#000000; padding:0 8px 8px 8px; line-height:1.8;">
                        Motorsport Data Solutions<br/>
                        1 Track Street, 00-001 Warsaw, Poland<br/>
                        VAT No: PL1234567890<br/>
                        Tel: +48 123 456 789<br/>
                    </td>
                </tr>
            </table>
        </td>

        <td width="4%">&nbsp;</td>

        <td width="48%" valign="top" style="border:1px solid #ddd; background-color:#fafafa;">
            <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="background-color:#e2e8f0; color:#111; font-weight:bold; font-size:10px; padding:6px 8px; text-transform:uppercase; border-bottom:1px solid #ddd;">
                        Buyer
                    </td>
                </tr>
                <tr>
                    <td style="font-size:13px; font-weight:bold; padding:8px 8px 2px 8px;">
                        <apex:outputText value="{!invoice.Order__r.Account.Name}"/>
                    </td>
                </tr>
                <tr>
                    <td style="font-size:11px; color:#000000; padding:0 8px 8px 8px; line-height:1.8;">
                        <apex:outputText value="{!invoice.Order__r.Account.BillingStreet}"/><br/>
                        <apex:outputText value="{!invoice.Order__r.Account.BillingCity}"/>,
                        <apex:outputText value="{!invoice.Order__r.Account.BillingCountry}"/><br/>
                        Tel: <apex:outputText value="{!invoice.Order__r.Account.Phone}"/>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;">
    <tr>
        <td style="border-top:3px solid #2C3E50; font-size:0;">&nbsp;</td>
    </tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:16px;">
    <tr>
        <td width="4%"  style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:center;">No.</td>
        <td width="36%" style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50;">Product Name</td>
        <td width="8%"  style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:center;">Quantity</td>
        <td width="14%" style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:right;">Unit Price</td>
        <td width="8%"  style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:center;">VAT</td>
        <td width="14%" style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:right;">Net Value</td>
        <td width="16%" style="background-color:#2C3E50; color:#fff; font-weight:bold; font-size:11px; padding:8px 6px; border:1px solid #2C3E50; text-align:right;">Grand Total</td>
    </tr>

    <apex:variable var="rowNum" value="{!1}" />
    <apex:repeat value="{!orderItems}" var="item">
        <tr>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:center;">
                <apex:outputText value="{0,number,0}">
                    <apex:param value="{!rowNum}"/>
                </apex:outputText>
            </td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px;">
                <apex:outputText value="{!item.Product2.Name}"/>
            </td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:center;">
                <apex:outputText value="{!item.Quantity}"/>
            </td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:right;">
                <apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!item.UnitPrice}"/>
                </apex:outputText>
            </td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:center;">23%</td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:right;">
                <apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!item.TotalPrice}"/>
                </apex:outputText>
            </td>
            <td style="padding:7px 6px; border:1px solid #ddd; font-size:11px; text-align:right;">
                <apex:outputText value="{0,number,#,##0.00}">
                    <apex:param value="{!item.TotalPrice * 1.23}"/>
                </apex:outputText>
            </td>
        </tr>
        <apex:variable var="rowNum" value="{!rowNum + 1}"/>
    </apex:repeat>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
    <tr>
        <td width="54%">&nbsp;</td>

        <td width="46%" valign="top">
            <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; border:2px solid #2C3E50;">
                <tr>
                    <td style="padding:7px 12px; border-bottom:1px solid #eee; font-size:11px;">Net Total:</td>
                    <td style="padding:7px 12px; border-bottom:1px solid #eee; font-size:11px; text-align:right;">
                        <apex:outputText value="{0,number,#,##0.00}"><apex:param value="{!subtotal}"/></apex:outputText> USD
                    </td>
                </tr>
                <tr>
                    <td style="padding:7px 12px; border-bottom:1px solid #eee; font-size:11px;">VAT (23%):</td>
                    <td style="padding:7px 12px; border-bottom:1px solid #eee; font-size:11px; text-align:right;">
                        <apex:outputText value="{0,number,#,##0.00}"><apex:param value="{!vatAmount}"/></apex:outputText> USD
                    </td>
                </tr>
                <tr>
                    <td style="padding:9px 12px; background-color:#2C3E50; color:#fff; font-weight:bold; font-size:13px;">Total:</td>
                    <td style="padding:9px 12px; background-color:#2C3E50; color:#fff; font-weight:bold; font-size:13px; text-align:right;">
                        <apex:outputText value="{0,number,#,##0.00}"><apex:param value="{!total}"/></apex:outputText> USD
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<apex:outputPanel rendered="{!NOT(ISBLANK($CurrentPage.parameters.sigId))}">
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;">
        <tr>
            <td style="border-top:1px dashed #bbb; padding-top:12px;">
                <div style="font-size:10px; text-transform:uppercase; color:#999; margin-bottom:8px;">
                    Authorized Electronic Signature
                </div>
                <apex:image url="/sfc/servlet.shepherd/version/download/{!$CurrentPage.parameters.sigId}"
                            width="200" height="70"/>
                <div style="font-size:10px; color:#999; margin-top:5px;">
                    Signed electronically on:
                    <apex:outputText value="{0,date,dd/MM/yyyy}">
                        <apex:param value="{!TODAY()}"/>
                    </apex:outputText>
                </div>
            </td>
        </tr>
    </table>
</apex:outputPanel>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-top:30px;">
    <tr>
        <td style="border-top:1px solid #ddd; padding-top:10px; text-align:center; font-size:10px; color:#aaa; line-height:1.8;">
            ApexSync — Motorsport Data Solutions<br/>
            Thank you for your business!
        </td>
    </tr>
</table>

</body>
</html>
</apex:page>