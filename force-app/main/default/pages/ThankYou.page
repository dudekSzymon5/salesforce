<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<html lang="en">
<head>
  <meta http-equiv="Content-type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Podium Finish — ApexSync</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&amp;family=DM+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --red:    #E10600;
      --red2:   #C50500;
      --bg:     #F4F4F4;
      --s0:     #FFFFFF;
      --s1:     #F8F8F8;
      --border: #E2E2E2;
      --text:   #0A0A0A;
      --mid:    #5A5A5A;
      --muted:  #AAAAAA;
      --teal:   #007A6E;
      --r:      5px;
      --sans:   'DM Sans', sans-serif;
      --mono:   'DM Sans', sans-serif;
    }

    body {
      font-family: var(--sans);
      background-color: var(--bg);
      background-image: radial-gradient(rgba(0,0,0,.07) 1px, transparent 1px);
      background-size: 20px 20px;
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      padding-bottom: 140px;
    }

    /* ── TICKER BAR ────────────────────────────────────────────────── */
    .ticker {
      background: var(--text);
      color: #fff;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .07em;
      padding: 5px 0;
      overflow: hidden;
      white-space: nowrap;
      user-select: none;
    }
    .ticker-inner { display: inline-block; animation: tickerScroll 32s linear infinite; }
    .ticker-inner span { margin: 0 2.5rem; opacity: .92; }
    .ticker-inner span::before { content: '■ '; opacity: .6; }
    @keyframes tickerScroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* ── LOGO ──────────────────────────────────────────────────────── */
    .logo-wrap { position: fixed; top: 24px; left: 22px; z-index: 30; }
    .logo { height: 30px; display: block; }

    /* ── TRACK STRIPE ──────────────────────────────────────────────── */
    .track-stripe {
      position: fixed; bottom: 50px; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(225,6,0,.3) 20%, rgba(225,6,0,.3) 80%, transparent);
      pointer-events: none; z-index: 1;
    }
    .track-stripe-2 {
      position: fixed; bottom: 48px; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,0,0,.08) 20%, rgba(0,0,0,.08) 80%, transparent);
      pointer-events: none; z-index: 1;
    }

    /* ── PAGE CONTAINER ────────────────────────────────────────────── */
    .page {
      position: relative; z-index: 10;
      max-width: 560px; margin: 0 auto;
      padding: 2rem 1rem 160px;
      min-height: calc(100vh - 22px);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center;
      animation: fadeUp .55s ease both;
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── ICON ──────────────────────────────────────────────────────── */
    .icon-wrap {
      width: 88px; height: 88px; border-radius: 50%;
      background: var(--s0);
      border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 2rem;
      position: relative;
      animation: popIn .55s cubic-bezier(.34,1.56,.64,1) .2s both;
    }
    @keyframes popIn {
      from { opacity: 0; transform: scale(.4); }
      to   { opacity: 1; transform: scale(1); }
    }
    .icon-wrap::before {
      content: ''; position: absolute; inset: -8px; border-radius: 50%;
      border: 2px solid rgba(225,6,0,.2);
      animation: ringPulse 2.2s ease-out infinite;
    }
    @keyframes ringPulse {
      0%   { transform: scale(1); opacity: .7; }
      100% { transform: scale(1.55); opacity: 0; }
    }
    .icon-wrap::after {
      content: ''; position: absolute; inset: -18px; border-radius: 50%;
      border: 1px solid rgba(225,6,0,.1);
      animation: ringPulse 2.2s ease-out .6s infinite;
    }

    /* ── EYEBROW ───────────────────────────────────────────────────── */
    .eyebrow {
      font-family: var(--mono);
      font-size: 10px; letter-spacing: .2em; color: var(--red);
      margin-bottom: .8rem;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .eyebrow::before, .eyebrow::after {
      content: ''; width: 18px; height: 2px; background: var(--red); flex-shrink: 0;
    }

    /* ── HEADING ───────────────────────────────────────────────────── */
    h1 {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(48px, 10vw, 72px);
      font-weight: 400; line-height: 1;
      letter-spacing: -.01em; text-transform: uppercase;
      margin-bottom: .5rem;
    }
    h1 em { color: var(--red); font-style: normal; }
    .sub {
      font-size: 14px; color: var(--mid); line-height: 1.65;
      margin-bottom: 2rem; max-width: 380px; font-weight: 400;
    }

    /* ── CONFETTI ──────────────────────────────────────────────────── */
    .confetti-wrap { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 5; }
    .conf {
      position: absolute;
      animation: confFall var(--d) ease-out forwards;
      animation-delay: var(--dl);
      opacity: 0;
    }
    @keyframes confFall {
      0%   { transform: translateY(0) translateX(0) rotate(0); opacity: 0; }
      8%   { opacity: 1; }
      100% { transform: translateY(var(--dy)) translateX(var(--dx)) rotate(var(--rot)); opacity: 0; }
    }

    /* ── TELEMETRY STATS ───────────────────────────────────────────── */
    .telem {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; margin-bottom: 1.8rem; width: 100%;
      border: 1px solid var(--border); border-radius: 4px;
      overflow: hidden; background: var(--border);
    }
    .tl { background: var(--s0); padding: 10px 12px; text-align: center; }
    .tl-val {
      font-family: var(--mono); font-size: 17px;
      color: var(--text); line-height: 1; margin-bottom: 3px;
    }
    .tl-val .accent { color: var(--red); }
    .tl-lbl { font-size: 9px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }

    /* ── CARD ──────────────────────────────────────────────────────── */
    .card {
      background: var(--s0);
      border: 1px solid var(--border);
      border-top: 2px solid var(--red);
      border-radius: 4px;
      padding: 1.8rem 1.8rem 2rem;
      box-shadow: 0 2px 12px rgba(0,0,0,.07), 0 1px 3px rgba(0,0,0,.05);
      width: 100%;
    }

    /* ── BADGES ────────────────────────────────────────────────────── */
    .badges {
      display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;
      margin-top: 1.2rem;
    }
    .badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 14px; border-radius: 3px;
      font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
      background: var(--s1); color: var(--mid);
      border: 1px solid var(--border);
    }
    .badge .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--red); flex-shrink: 0;
      animation: dotBlink 1.8s ease-in-out infinite;
    }
    .badge .dot.green { background: #16a34a; animation-delay: .4s; }
    @keyframes dotBlink {
      0%, 100% { opacity: 1; } 50% { opacity: .25; }
    }

    /* ── DIVIDER ───────────────────────────────────────────────────── */
    .divider {
      width: 100%; height: 1px; background: var(--border); margin: 1.6rem 0;
    }

    /* ── NEXT STEPS ────────────────────────────────────────────────── */
    .steps {
      display: flex; flex-direction: column; gap: 10px;
      text-align: left; width: 100%;
    }
    .step {
      display: flex; align-items: flex-start; gap: 12px;
    }
    .step-num {
      font-family: var(--mono); font-size: 10px; color: var(--red);
      background: rgba(225,6,0,.07); border: 1px solid rgba(225,6,0,.2);
      border-radius: 3px; padding: 3px 7px; flex-shrink: 0; line-height: 1.6;
    }
    .step-text { font-size: 13px; color: var(--mid); line-height: 1.5; padding-top: 3px; }
    .step-text strong { color: var(--text); font-weight: 600; }

    @media (max-width: 480px) {
      .page { padding: 4.5rem .75rem 3rem; }
      h1 { font-size: 48px; }
      .telem { grid-template-columns: repeat(3,1fr); }
    }
  </style>
</head>
<body>

<!-- ── TICKER ───────────────────────────────────────────────────────── -->
<div class="ticker">
  <div class="ticker-inner">
    <span>SUBMISSION RECEIVED</span>
    <span>LAP COMPLETE</span>
    <span>PIT STOP SUCCESSFUL</span>
    <span>TEAM NOTIFIED</span>
    <span>RESPONSE ETA: &lt;24H</span>
    <span>SECTOR 3 CLEARED</span>
    <span>APEXSYNC RACING</span>
    <span>SUBMISSION RECEIVED</span>
    <span>LAP COMPLETE</span>
    <span>PIT STOP SUCCESSFUL</span>
    <span>TEAM NOTIFIED</span>
    <span>RESPONSE ETA: &lt;24H</span>
    <span>SECTOR 3 CLEARED</span>
    <span>APEXSYNC RACING</span>
  </div>
</div>

<!-- ── LOGO ─────────────────────────────────────────────────────────── -->
<div class="logo-wrap">
  <img src="{!URLFOR($Resource.ApexSync)}" alt="ApexSync" class="logo" />
</div>

<!-- ── CONFETTI ──────────────────────────────────────────────────────── -->
<div class="confetti-wrap" id="confetti"></div>

<!-- ── PAGE ─────────────────────────────────────────────────────────── -->
<div class="page">

  <!-- Icon -->
  <div class="icon-wrap">
    <!-- Checkered flag -->
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="6" width="3" height="28" rx="1.5" fill="#0A0A0A"/>
      <!-- flag grid -->
      <rect x="11" y="6"  width="5" height="5" fill="#0A0A0A"/>
      <rect x="16" y="6"  width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>
      <rect x="21" y="6"  width="5" height="5" fill="#0A0A0A"/>
      <rect x="26" y="6"  width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>

      <rect x="11" y="11" width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>
      <rect x="16" y="11" width="5" height="5" fill="#0A0A0A"/>
      <rect x="21" y="11" width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>
      <rect x="26" y="11" width="5" height="5" fill="#0A0A0A"/>

      <rect x="11" y="16" width="5" height="5" fill="#0A0A0A"/>
      <rect x="16" y="16" width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>
      <rect x="21" y="16" width="5" height="5" fill="#0A0A0A"/>
      <rect x="26" y="16" width="5" height="5" fill="#fff" stroke="#E2E2E2" stroke-width=".5"/>
    </svg>
  </div>

  <!-- Heading -->
  <h1>THANK YOU FOR <em>REACHING</em> OUT</h1>
  <p class="sub">Your enquiry has been received.<br/>Our team will get back to you within 24 business hours.</p>



</div>

<!-- ── TRACK LINE ─────────────────────────────────────────────────────── -->
<div class="track-stripe"></div>
<div class="track-stripe-2"></div>

<script>
/* Telemetry live numbers */
(function () {
  var spd = document.getElementById('tl-spd');
  var rpm = document.getElementById('tl-rpm');
  var lap = document.getElementById('tl-lap');
  setInterval(function () {
    var s = 295 + Math.round(Math.random() * 28);
    spd.textContent = s;
    var r = 10800 + Math.round(Math.random() * 1400);
    rpm.innerHTML = r.toString().slice(0,2) + '<span class="accent">,</span>' + r.toString().slice(2);
    var m = 1, sec = 12 + Math.random() * 4;
    lap.innerHTML = m + '<span class="accent">:</span>' + sec.toFixed(1);
  }, 900);
})();

/* Confetti burst */
(function () {
  var wrap = document.getElementById('confetti');
  var colors = ['#E10600', '#FF8000', '#0A0A0A', '#FFFFFF', '#005AFF', '#FFD700', '#C50500'];
  for (var i = 0; i < 55; i++) {
    var el = document.createElement('div');
    el.className = 'conf';
    var isRect = Math.random() > .5;
    var size = (4 + Math.random() * 6) + 'px';
    el.style.cssText = [
      'left:' + (10 + Math.random() * 80) + '%',
      'top:10%',
      'width:' + size,
      'height:' + (isRect ? (parseInt(size) * 1.6) + 'px' : size),
      'background:' + colors[Math.floor(Math.random() * colors.length)],
      'border-radius:' + (isRect ? '2px' : '50%'),
      '--d:' + (1.2 + Math.random() * 1.8) + 's',
      '--dl:' + (Math.random() * .8) + 's',
      '--dy:' + (220 + Math.random() * 350) + 'px',
      '--dx:' + (Math.random() * 160 - 80) + 'px',
      '--rot:' + (Math.random() * 900 - 450) + 'deg'
    ].join(';');
    wrap.appendChild(el);
  }
})();
</script>
</body>
</html>
</apex:page>