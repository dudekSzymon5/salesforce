<script>
// ── CONSTANTS ───────────────────────────────────────────────────────────────
var REQUIRED   = ['first_name', 'last_name', 'email', 'company', 'city', 'country_code'];
var VALIDATORS = {
  first_name:   function(v) { return /^[^\d]{2,40}$/.test(v.trim()); },
  last_name:    function(v) { return /^[^\d]{2,80}$/.test(v.trim()); },
  email:        function(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()); },
  company:      function(v) { return v.trim().length >= 2 && v.trim().length <= 40; },
  city:         function(v) { return /^[^\d]{2,40}$/.test(v.trim()); },
  country_code: function(v) { return v.trim() !== ''; },
  mobile:       function(v) { return v.trim() === '' || /^[\d\s\+\-\(\)]{7,20}$/.test(v.trim()); }
};

// ── BLOCK DISALLOWED CHARS ───────────────────────────────────────────────────
['first_name', 'last_name', 'city'].forEach(function(id) {
  var el = document.getElementById(id);
  if (!el) return;
  el.addEventListener('keypress', function(e) { if (/\d/.test(e.key)) e.preventDefault(); });
  el.addEventListener('input', function() {
    var sel = this.selectionStart;
    var cleaned = this.value.replace(/\d/g, '');
    if (cleaned !== this.value) { this.value = cleaned; this.setSelectionRange(sel - 1, sel - 1); }
  });
});

var mobileEl = document.getElementById('mobile');
if (mobileEl) {
  mobileEl.addEventListener('keypress', function(e) {
    if (!/[\d\s\+\-\(\)]/.test(e.key) && e.key !== 'Backspace' && e.key !== 'Delete') e.preventDefault();
  });
  mobileEl.addEventListener('input', function() {
    var sel = this.selectionStart;
    var cleaned = this.value.replace(/[^\d\s\+\-\(\)]/g, '');
    if (cleaned !== this.value) { this.value = cleaned; this.setSelectionRange(sel - 1, sel - 1); }
  });
}

// ── VALIDATION ───────────────────────────────────────────────────────────────
function validateField(id, show) {
  var el  = document.getElementById(id);
  var err = document.getElementById('e-' + id);
  if (!el) return true;
  var val   = el.value;
  var empty = val.trim() === '';
  var isReq = REQUIRED.indexOf(id) > -1;
  var fn    = VALIDATORS[id];
  var valid = fn ? fn(val) : true;
  var ok    = isReq ? (!empty && valid) : (empty || valid);
  el.classList.toggle('is-ok',  ok && !empty);
  el.classList.toggle('is-err', show && !ok);
  if (err) err.classList.toggle('show', show && !ok);
  return ok;
}

// ── PROGRESS BAR ─────────────────────────────────────────────────────────────
function updateProgress() {
  var filled = REQUIRED.filter(function(id) {
    var e = document.getElementById(id);
    return e && VALIDATORS[id] && VALIDATORS[id](e.value);
  }).length;
  var pct = Math.round((filled / REQUIRED.length) * 100);
  document.getElementById('prog').style.width = pct + '%';
  document.getElementById('prog-pct').textContent = pct + '%';
}

// ── FIELD EVENTS ──────────────────────────────────────────────────────────────
['first_name', 'last_name', 'email', 'company', 'city', 'mobile'].forEach(function(id) {
  var el = document.getElementById(id);
  if (!el) return;
  el.addEventListener('blur',  function() { validateField(id, true); updateProgress(); });
  el.addEventListener('input', function() { if (el.classList.contains('is-err')) validateField(id, true); updateProgress(); });
});
document.getElementById('country_code').addEventListener('change', function() {
  validateField('country_code', true);
  updateProgress();
});

// ── SUBMIT ────────────────────────────────────────────────────────────────────
document.getElementById('wtl').addEventListener('submit', function(e) {
  e.preventDefault();
  var ok = true;
  REQUIRED.forEach(function(id) { if (!validateField(id, true)) ok = false; });
  if (!validateField('mobile', true)) ok = false;
  if (!ok) {
    document.querySelectorAll('.is-err').forEach(function(el) {
      el.classList.remove('shake');
      void el.offsetWidth; // reflow to restart animation
      el.classList.add('shake');
      el.addEventListener('animationend', function() { el.classList.remove('shake'); }, { once: true });
    });
    var first = document.querySelector('.is-err');
    if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }
  var btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.classList.add('loading');
  btn.querySelector('.btn-txt').textContent = 'IGNITION...';
  document.getElementById('prog').style.width = '100%';
  document.getElementById('prog-pct').textContent = '100%';
  e.target.submit();
});

// ── RESET ON BACK/FORWARD CACHE ───────────────────────────────────────────────
window.addEventListener('pageshow', function(e) {
  if (e.persisted) {
    var btn = document.getElementById('submit-btn');
    btn.disabled = false;
    btn.classList.remove('loading');
    btn.querySelector('.btn-txt').textContent = 'Submit';
    document.getElementById('wtl').reset();
    document.getElementById('prog').style.width = '0%';
    document.getElementById('prog-pct').textContent = '0%';
    document.querySelectorAll('.ctrl').forEach(function(el) {
      el.classList.remove('is-ok', 'is-err');
    });
  }
});

// ── LIVE TELEMETRY ────────────────────────────────────────────────────────────
function rnd(a, b) { return Math.floor(Math.random() * (b - a + 1)) + a; }
setInterval(function() {
  var spd = document.getElementById('tel-speed');
  var ms  = document.getElementById('tel-ms');
  var rpm = document.getElementById('tel-rpm');
  if (spd) spd.textContent = rnd(312, 342);
  if (ms)  ms.textContent  = ('00' + rnd(100, 999)).slice(-3);
  if (rpm) rpm.textContent = rnd(10800, 13500).toLocaleString();
}, 1100);
</script>
